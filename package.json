{
  "name": "reviewdeck",
  "version": "0.1.0",
  "description": "Aggregate code review requests across every Git host you work with.",
  "main": "./out/main/index.js",
  "author": "Vojtěch Mareš <vojtech@mares.cz>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "node scripts/make-icon.mjs",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "dist": "pnpm run build && electron-builder --mac --publish never --config electron-builder.yml -c.mac.identity=\"$(./scripts/signing-identity.sh)\"",
    "dist:dir": "pnpm run build && electron-builder --mac --dir --config electron-builder.yml -c.mac.identity=\"$(./scripts/signing-identity.sh)\""
  },
  "devDependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.6"
  }
}
